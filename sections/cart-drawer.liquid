<div id="ajax-loading-cart">
  {% render 'cart-drawer', section: section %}
</div>

{% schema %}
{
  "name": "t:sections.cart-drawer.name",
  "class": "section-cart-drawer",
  "limit": 1,
  "enabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart-drawer.settings.apps_info"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "heading",
      "name": "t:sections.cart-drawer.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.cart-drawer.blocks.heading.settings.heading.label",
          "default": "También te puede interesar"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.custom-liquid.name",
          "info": "t:sections.custom-liquid.settings.custom_liquid.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.cart-drawer.name"
    }
  ]
}
{% endschema %}
