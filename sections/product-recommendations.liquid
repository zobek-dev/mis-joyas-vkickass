{%- liquid
  assign products_to_show = section.settings.products_to_show | plus: 0
  assign columns_desktop = section.settings.columns_desktop | plus: 0
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  if columns_mobile < 1
    assign columns_mobile = 2
  endif
  if columns_desktop < 1
    assign columns_desktop = 4
  endif

  assign gap_desktop = section.settings.spacing | default: 16
  assign gap_mobile = section.settings.spacing_mobile | default: 12
  assign pad_x = section.settings.padding_x | default: 80
  assign pad_x_mobile = section.settings.padding_x_mobile | default: 20

  # Peek solo desktop (Figma 1838:14769). Mobile: 2 cards exactas (sin recorte).
  assign per_page_desktop = columns_desktop | times: 1.0 | plus: 0.25
  assign per_page_mobile = columns_mobile | times: 1.0

  assign disable_quickview = true
  if section.settings.show_quickview
    assign disable_quickview = false
  endif

  assign rec_count = 0
  if recommendations.performed
    for recommendation in recommendations.products
      if recommendation.metafields.custom.excluded_from_recommendation != true
        assign rec_count = rec_count | plus: 1
      endif
      if rec_count >= products_to_show
        break
      endif
    endfor
  endif

  assign enable_slider = false
  if rec_count > columns_mobile
    assign enable_slider = true
  endif

  assign slide_count = rec_count
-%}

{%- style -%}
  .product-rec-mj-{{ section.id }} {
    --pr-mj-gap: {{ gap_desktop }}px;
    --pr-mj-gap-mobile: {{ gap_mobile }}px;
    width: 100%;
    padding: {{ section.settings.padding_top_mobile }}px {{ pad_x_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    box-sizing: border-box;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .product-rec-mj-{{ section.id }} {
      /* Desktop: sin padding derecho para peek del 5.º producto */
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px {{ pad_x }}px;
    }
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
  }
  @media (min-width: 768px) {
    .product-rec-mj-{{ section.id }} .product-rec-mj__header,
    .product-rec-mj-{{ section.id }} .product-rec-mj__footer {
      padding-right: {{ pad_x }}px;
    }
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin: 0 0 1.875rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .product-rec-mj-{{ section.id }} .product-rec-mj__header {
      margin-bottom: 2rem;
    }
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__eyebrow {
    margin: 0;
    color: {{ section.settings.eyebrow_color | default: '#68B5A3' }};
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    text-transform: uppercase;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__heading {
    margin: 0;
    color: #222222;
    font-size: 1.625rem;
    line-height: 2rem;
    font-weight: 400;
  }
  @media (min-width: 768px) {
    .product-rec-mj-{{ section.id }} .product-rec-mj__heading {
      font-size: 2rem;
      line-height: 2.5rem;
    }
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__track {
    padding-left: 0;
    padding-right: 0;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__slider,
  .product-rec-mj-{{ section.id }} .product-rec-mj__carousel {
    position: relative;
  }
  @media (max-width: 767px) {
    .product-rec-mj-{{ section.id }} .preload-slide-{{ section.id }} {
      {%- if settings.lang_direction contains request.locale.iso_code -%}
        margin-left: {{ gap_mobile }}px;
      {%- else -%}
        margin-right: {{ gap_mobile }}px;
      {%- endif -%}
      width: calc(((100% + {{ gap_mobile }}px) / {{ per_page_mobile }}) - {{ gap_mobile }}px);
    }
  }
  @media (min-width: 768px) {
    .product-rec-mj-{{ section.id }} .preload-slide-{{ section.id }} {
      {%- if settings.lang_direction contains request.locale.iso_code -%}
        margin-left: {{ gap_desktop }}px;
      {%- else -%}
        margin-right: {{ gap_desktop }}px;
      {%- endif -%}
      width: calc(((100% + {{ gap_desktop }}px) / {{ per_page_desktop }}) - {{ gap_desktop }}px);
    }
  }
  .product-rec-mj-{{ section.id }} .splide__arrows {
    display: none;
  }
  @media (min-width: 768px) {
    .product-rec-mj-{{ section.id }} .splide__arrows {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 30;
    }
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__progress {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 1.25rem 0 0;
    padding: 0;
    box-sizing: border-box;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__progress .splide-progress {
    display: block;
    width: 100%;
    min-height: 3px;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(34, 34, 34, 0.12);
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__progress .splide-progress-bar {
    display: block;
    height: 3px;
    max-width: 100%;
    border-radius: 4px;
    background: #222222;
    margin: 0;
    transform: none;
    transition: width 0.25s ease;
    will-change: width;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow {
    pointer-events: auto;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 28px;
    min-height: 44px;
    padding: 10px 2px;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: #222222;
    box-shadow: none;
    cursor: pointer;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }
  .product-rec-mj-{{ section.id }} .x-splide:hover .product-rec-mj__arrow {
    transform: translateY(-50%);
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow:hover,
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow:focus,
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow:focus-visible {
    background: rgba(255, 255, 255, 1);
    color: #222222;
    box-shadow: none;
    opacity: 1;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow--prev {
    left: 0;
    border-radius: 0 6px 6px 0;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow--next {
    right: 0;
    border-radius: 6px 0 0 6px;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__arrow-icon svg {
    width: 24px;
    height: 24px;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    min-height: 50px;
    padding: 10px 30px;
    border: 1px solid #222222;
    border-radius: 4px;
    color: #222222;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.375rem;
    text-decoration: none;
    text-align: center;
    width: auto;
    max-width: none;
    background-color: transparent;
    transition: background-color 0.15s ease;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__view-all:hover,
  .product-rec-mj-{{ section.id }} .product-rec-mj__view-all:focus-visible {
    background-color: #f2f2f2;
  }
  .product-rec-mj-{{ section.id }} .product-rec-mj__footer {
    display: flex;
    justify-content: center;
  }
{%- endstyle -%}

<div
  class="product-recommendations"
  {% unless request.design_mode %}
    x-data="{ loading: false }"
    x-intersect.once.margin.200px="loading = true;$store.xProductRecommendations.load($el, '{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ products_to_show }}')"
  {% endunless %}
>
  {%- if request.design_mode or recommendations.performed and rec_count > 0 -%}
    <div class="product-rec-mj-{{ section.id }} tw-w-full">
      <div class="product-rec-mj__inner">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div class="product-rec-mj__header">
            {%- if section.settings.eyebrow != blank -%}
              <p class="product-rec-mj__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="product-rec-mj__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if request.design_mode and rec_count == 0 -%}
          {%- style -%}
            .product-rec-mj-dm-grid-{{ section.id }} {
              display: grid;
              grid-template-columns: repeat(2, minmax(0, 1fr));
              gap: {{ gap_mobile }}px;
            }
            @media (min-width: 768px) {
              .product-rec-mj-dm-grid-{{ section.id }} {
                grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
                gap: {{ gap_desktop }}px;
              }
            }
          {%- endstyle -%}
          <div class="product-rec-mj__slider">
            <div class="product-rec-mj__carousel">
              <div class="product-rec-mj-dm-grid-{{ section.id }}">
                {%- for i in (1..columns_desktop) -%}
                  <div class="tw-flex tw-flex-col tw-overflow-hidden">
                    <div class="tw-aspect-square tw-bg-[#f2f2f2]"></div>
                    <div class="tw-h-3 tw-w-3/4 tw-bg-[#f2f2f2] tw-mt-4"></div>
                    <div class="tw-h-3 tw-w-1/2 tw-bg-[#f2f2f2] tw-mt-2 tw-mb-4"></div>
                  </div>
                {%- endfor -%}
              </div>
              <p class="tw-text-center tw-text-sm tw-text-[#737373] tw-mt-4">
                {{ 'sections.product-recommendations.design_mode_hint' | t }}
              </p>
            </div>
          </div>
          {%- if section.settings.show_view_all and section.settings.button_label != blank -%}
            <div class="product-rec-mj__footer">
              <span class="product-rec-mj__view-all">{{ section.settings.button_label | escape }}</span>
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="product-rec-mj__slider">
            <div
              id="product-rec-mj-{{ section.id }}"
              class="product-rec-mj__carousel carousel-mobile carousel-tablet overflow-hidden x-splide splide visible disable-effect-hover{% unless enable_slider %} product-rec-mj__carousel--static{% endunless %}"
              {% if enable_slider %}
                x-data-slider="{{ section.id }}"
                x-intersect.once.margin.200px='$store.xSplide.load($el, {
                  "speed": 360,
                  "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
                  "type": "slide",
                  "mediaQuery": "min",
                  "updateOnMove": true,
                  "waitForTransition": false,
                  "flickPower": 350,
                  "flickMaxPages": 2,
                  "dragMinThreshold": { "mouse": 0, "touch": 5 },
                  "gap": "{{ gap_mobile }}px",
                  "perPage": {{ per_page_mobile }},
                  "perMove": 1,
                  "autoWidth": false,
                  "arrows": false,
                  "pagination": false,
                  "drag": true,
                  "trimSpace": false,
                  "focus": 0,
                  {%- if settings.lang_direction contains request.locale.iso_code -%}
                    "direction": "rtl",
                  {%- endif -%}
                  "breakpoints": {
                    300: {
                      "gap": "{{ gap_mobile }}px",
                      "perPage": {{ per_page_mobile }},
                      "perMove": 1,
                      "speed": 360,
                      "waitForTransition": false
                    },
                    768: {
                      "destroy": false,
                      "perPage": {{ per_page_desktop }},
                      "perMove": 1,
                      "autoWidth": false,
                      "gap": "{{ gap_desktop }}px",
                      "drag": true,
                      "focus": 0,
                      "speed": 500,
                      "waitForTransition": false
                    },
                    1024: {
                      "perPage": {{ per_page_desktop }},
                      "perMove": 1,
                      "gap": "{{ gap_desktop }}px",
                      "focus": 0,
                      "speed": 500
                    }
                  },
                  "classes": {
                    "arrows": "splide__arrows",
                    "pagination": "hidden"
                  },
                  "events": [
                    {
                      "event": "ready",
                      "callback": function () {
                        document.dispatchEvent(new CustomEvent("eurus:{{ section.id }}:splide-ready"));
                      }
                    },
                    {
                      "event": "mounted resized",
                      "callback": function () {
                        if (window.bindProductRecMjProgress) {
                          window.bindProductRecMjProgress("{{ section.id }}");
                        }
                        if (window.bindFeaturedCollectionMjArrows) {
                          window.bindFeaturedCollectionMjArrows(
                            document.getElementById("product-rec-mj-{{ section.id }}"),
                            1,
                            1
                          );
                        }
                      }
                    }
                  ]
                })'
              {% endif %}
            >
              <div class="splide__track product-rec-mj__track overflow-hidden w-full{% if enable_slider %} cursor-grab md:cursor-grab{% endif %}">
                <div class="splide__list md:grid-cols-none md:flex md:w-full md:gap-0 flex w-full">
                  {%- assign count_product_to_show = 0 -%}
                  {%- for recommendation in recommendations.products -%}
                    {%- if recommendation.metafields.custom.excluded_from_recommendation != true -%}
                      {%- assign pr_mj_class_slide = 'splide__slide x-splide-slide preload-slide-' | append: section.id | append: ' h-auto' -%}
                      {% render 'card-product',
                        card_product: recommendation,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        show_highlighted_attributes: section.settings.show_highlighted_attributes,
                        section_id: section.id,
                        class_slide: pr_mj_class_slide,
                        column_mobile: columns_mobile,
                        columns_desktop: columns_desktop,
                        index: forloop.index,
                        list_name: section.settings.heading,
                        block_id: section.id,
                        product_card_id: forloop.index,
                        disable_quickview: disable_quickview,
                        media_aspect_ratio: '100',
                        swiper_on_mobile: enable_slider,
                        enable_desktop_slider: enable_slider,
                        animation_loading: true,
                        show_price_range: true
                      %}
                      {%- assign count_product_to_show = count_product_to_show | plus: 1 -%}
                    {%- endif -%}
                    {%- if count_product_to_show >= products_to_show -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

              {%- if enable_slider -%}
                <div class="splide__arrows{% if settings.lang_direction contains request.locale.iso_code %} rtl{% endif %}">
                  <button
                    type="button"
                    data-fc-mj-arrow="prev"
                    class="product-rec-mj__arrow product-rec-mj__arrow--prev splide__arrow splide__arrow--prev none_border"
                    aria-label="{{ 'sections.product-recommendations.previous' | t }}"
                  >
                    <span class="product-rec-mj__arrow-icon rotate-90 rtl:-rotate-90" aria-hidden="true">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </button>
                  <button
                    type="button"
                    data-fc-mj-arrow="next"
                    class="product-rec-mj__arrow product-rec-mj__arrow--next splide__arrow splide__arrow--next none_border"
                    aria-label="{{ 'sections.product-recommendations.next' | t }}"
                  >
                    <span class="product-rec-mj__arrow-icon -rotate-90 rtl:rotate-90" aria-hidden="true">
                      {% render 'icon-alls', icon: 'icon-caret' %}
                    </span>
                  </button>
                </div>
              {%- endif -%}
            </div>

            {%- if enable_slider -%}
              {%- liquid
                assign slide_count_f = slide_count | times: 1.0
                assign mobile_width_bar = per_page_mobile | divided_by: slide_count_f
                if mobile_width_bar > 1.0
                  assign mobile_width_bar = 1.0
                endif
                assign desktop_width_bar = per_page_desktop | divided_by: slide_count_f
                if desktop_width_bar > 1.0
                  assign desktop_width_bar = 1.0
                endif
              -%}
              {%- style -%}
                #product-rec-mj-progress-{{ section.id }} .splide-progress-bar {
                  width: {{ mobile_width_bar | times: 100 }}%;
                }
                @media (min-width: 768px) {
                  #product-rec-mj-progress-{{ section.id }} .splide-progress-bar {
                    width: {{ desktop_width_bar | times: 100 }}%;
                  }
                }
              {%- endstyle -%}
              <div
                id="product-rec-mj-progress-{{ section.id }}"
                class="product-rec-mj__progress"
              >
                <div class="splide-progress rounded-md">
                  <div
                    class="splide-progress-bar-{{ section.id }} splide-progress-bar rounded-md"
                    data-thumb-pct-mobile="{{ mobile_width_bar | times: 100 }}"
                    data-thumb-pct-desktop="{{ desktop_width_bar | times: 100 }}"
                  ></div>
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.show_view_all and section.settings.button_label != blank -%}
            <div class="product-rec-mj__footer">
              <a
                href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
                class="product-rec-mj__view-all"
                {% if section.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- elsif request.design_mode == false -%}
    <div
      x-show="loading"
      class="product-rec-mj-{{ section.id }}"
      x-cloak
    >
      <div class="product-rec-mj__inner">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div class="product-rec-mj__header">
            {%- if section.settings.eyebrow != blank -%}
              <p class="product-rec-mj__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="product-rec-mj__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}
        {% render 'skeleton-product-recommendations'
          section_id: section.id,
          columns_desktop: columns_desktop,
          columns_mobile: columns_mobile,
          swiper_on_mobile: true,
          enable_desktop_slider: true,
          spacing: gap_desktop,
          spacing_mobile: gap_mobile,
          product_show: products_to_show,
          heading_alignment: 'center',
          show_content_above: false
        %}
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'preview-color-swatches.js' | asset_url }}" defer></script>
<script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.product-recommendations.name",
  "class": "section section-product-recommendations x-section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.product-recommendations.settings.paragraph__1.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NUESTRAS SUGERENCIAS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color del eyebrow",
      "default": "#68B5A3"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "También te puede gustar",
      "label": "t:sections.all.text.heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "t:sections.main-product.blocks.complementary.settings.max_product_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.collection-list.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Espacio entre tarjetas — escritorio"
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Espacio entre tarjetas — móvil"
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "Padding horizontal — escritorio"
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Padding horizontal — móvil"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "t:sections.all.padding.padding_bottom"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28,
      "label": "Padding top — móvil"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28,
      "label": "Padding bottom — móvil"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:settings_schema.search_navigation.settings.predictive_search_show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.featured-collection.blocks.collection.settings.show_rating.label"
    },
    {
      "type": "checkbox",
