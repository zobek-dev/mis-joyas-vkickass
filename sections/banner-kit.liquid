{%- if section.settings.enable -%}
  {%- unless section.settings.show_only_on_homepage and request.page_type != 'index' -%}
    {%- liquid
      assign kit_height = section.settings.banner_height
      assign kit_height_mobile = section.settings.banner_height_mobile
      if kit_height == blank
        assign kit_height = 340
      endif
      if kit_height_mobile == blank
        assign kit_height_mobile = 636
      endif
      assign has_blocks = false
      if section.blocks.size > 0
        assign has_blocks = true
      endif
      assign enable_slider = false
      if section.blocks.size > 1
        assign enable_slider = true
      endif
      assign show_sparkles = section.settings.show_sparkles
      assign autoplay_ms = section.settings.change_slides_speed | default: 5 | times: 1000
      assign mobile_ratio_w = 440
      assign mobile_ratio_h = kit_height_mobile
      assign mobile_ratio_found = false
      for block in section.blocks
        unless mobile_ratio_found
          # Preferir preview del video mobile para no forzar un ratio ajeno (evita crop/escala pixelada)
          if block.settings.video_mobile != blank and block.settings.video_mobile.preview_image != blank
            assign mobile_ratio_w = block.settings.video_mobile.preview_image.width
            assign mobile_ratio_h = block.settings.video_mobile.preview_image.height
            assign mobile_ratio_found = true
          elsif block.settings.image_mobile != blank
            assign mobile_ratio_w = block.settings.image_mobile.width
            assign mobile_ratio_h = block.settings.image_mobile.height
            assign mobile_ratio_found = true
          elsif block.settings.image != blank
            assign mobile_ratio_w = block.settings.image.width
            assign mobile_ratio_h = block.settings.image.height
            assign mobile_ratio_found = true
          endif
        endunless
      endfor
    -%}

    {%- style -%}
      .banner-kit-{{ section.id }} {
        --banner-2-h: {{ kit_height }}px;
        --banner-2-h-mobile: {{ kit_height_mobile }}px;
        --banner-2-desktop-ratio: 1440 / {{ kit_height }};
        --banner-2-mobile-ratio: {{ mobile_ratio_w }} / {{ mobile_ratio_h }};
        --banner-2-radius: {{ section.settings.border_radius }}px;
        --banner-2-autoplay: {{ autoplay_ms }}ms;
        width: 100%;
        padding: {{ section.settings.padding_y_mobile }}px 0;
        box-sizing: border-box;
        overflow-x: clip;
        overflow-y: visible;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} {
          padding: {{ section.settings.padding_y }}px 0;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__stage {
        position: relative;
        width: 100%;
        overflow: visible;
      }
      .banner-kit-{{ section.id }} .banner-kit__frame {
        position: relative;
        width: 100%;
        height: auto;
        border-radius: var(--banner-2-radius);
        overflow: hidden;
        background: #1a1a1a;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__frame {
          aspect-ratio: var(--banner-2-desktop-ratio);
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__slider,
      .banner-kit-{{ section.id }} .splide__track,
      .banner-kit-{{ section.id }} .splide__list,
      .banner-kit-{{ section.id }} .banner-kit__slide {
        width: 100%;
        height: auto;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__slider,
        .banner-kit-{{ section.id }} .splide__track,
        .banner-kit-{{ section.id }} .splide__list,
        .banner-kit-{{ section.id }} .banner-kit__slide {
          height: 100%;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__slide {
        position: relative;
      }
      .banner-kit-{{ section.id }} .banner-kit__media,
      .banner-kit-{{ section.id }} .banner-kit__media-link {
        position: relative;
        inset: auto;
        display: block;
        width: 100%;
        height: auto;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__media,
        .banner-kit-{{ section.id }} .banner-kit__media-link {
          position: absolute;
          inset: 0;
          height: 100%;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__media-link {
        z-index: 1;
      }
      .banner-kit-{{ section.id }} .banner-kit__picture,
      .banner-kit-{{ section.id }} .banner-kit__video-wrap {
        display: block;
        position: relative;
        width: 100%;
        height: auto;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__picture,
        .banner-kit-{{ section.id }} .banner-kit__video-wrap {
          height: 100%;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: unset;
        object-position: center;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__img {
          height: 100%;
          object-fit: cover;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__video-wrap {
        aspect-ratio: var(--banner-2-mobile-ratio);
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__video-wrap {
          aspect-ratio: auto;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__video {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
      }
      @media (max-width: 767px) {
        /*
          Video mobile a tamaño intrínseco (sin caja forzada que lo estire).
          Si el MP4 es ~440px, object-fit:cover en un frame alto lo pixelaba en retina.
        */
        .banner-kit-{{ section.id }} .banner-kit__video-wrap {
          aspect-ratio: auto;
          height: auto;
        }
        .banner-kit-{{ section.id }} .banner-kit__video-wrap > div {
          position: relative !important;
          inset: auto !important;
          width: 100%;
          height: auto;
        }
        .banner-kit-{{ section.id }} .banner-kit__video {
          position: relative;
          inset: auto;
          width: 100%;
          height: auto;
          object-fit: unset;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__sparkle {
        position: absolute;
        top: 50%;
        z-index: 4;
        display: block;
        width: 60px;
        height: 59px;
        pointer-events: none;
        transform: translateY(-50%);
        color: #fff;
      }
      .banner-kit-{{ section.id }} .banner-kit__sparkle svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      .banner-kit-{{ section.id }} .banner-kit__sparkle--left {
        left: -30px;
      }
      .banner-kit-{{ section.id }} .banner-kit__sparkle--right {
        right: -30px;
      }
      @media (max-width: 767px) {
        .banner-kit-{{ section.id }} .banner-kit__sparkle {
          display: none;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__content {
        position: absolute;
        z-index: 3;
        left: 20px;
        right: 20px;
        bottom: 40px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        pointer-events: none;
      }
      @media (min-width: 768px) {
        .banner-kit-{{ section.id }} .banner-kit__content {
          left: 40px;
          right: 80px;
          top: 50%;
          bottom: auto;
          width: auto;
          transform: translateY(-50%);
          align-items: center;
          justify-content: flex-end;
        }
      }
      .banner-kit-{{ section.id }} .banner-kit__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-height: 50px;
        padding: 12px 32px;
        border: 0;
        border-radius: 4px;
        background: #f83785;
        background-image: none;
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        line-height: 22px;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
        pointer-events: auto;
        transition: background-color 0.2s ease, color 0.2s ease;
      }
      .banner-kit-{{ section.id }} .banner-kit__cta:hover,
      .banner-kit-{{ section.id }} .banner-kit__cta:focus,
      .banner-kit-{{ section.id }} .banner-kit__cta:focus-visible,
      .banner-kit-{{ section.id }} .banner-kit__cta:active {
        background: #000 !important;
        background-image: none !important;
        color: #fff !important;
        text-decoration: none;
      }
      .banner-kit-{{ section.id }} .banner-kit__cta::before,
      .banner-kit-{{ section.id }} .banner-kit__cta::after {
        content: none !important;
        display: none !important;
      }
      .banner-kit-{{ section.id }} .banner-kit__placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        background: #eae3d9;
        color: #222;
        font-size: 0.875rem;
        text-align: center;
        padding: 1.5rem;
      }
      .banner-kit-{{ section.id }} .banner-kit__progress {
        display: flex;
        justify-content: center;
        width: 100%;
        margin-top: 20px;
      }
      .banner-kit-{{ section.id }} .banner-kit__progress-track {
        position: relative;
        width: min(360px, calc(100% - 40px));
        height: 2px;
        overflow: hidden;
        background: #e0e0e0;
      }
      .banner-kit-{{ section.id }} .banner-kit__progress-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 0%;
        background: #000;
        will-change: width;
      }
    {%- endstyle -%}

    <div
      class="banner-kit-{{ section.id }}"
      role="region"
      aria-label="{{ 'sections.banner-kit.aria_label' | t }}"
    >
      <div class="banner-kit__stage">
        {%- if show_sparkles -%}
          <span class="banner-kit__sparkle banner-kit__sparkle--left" aria-hidden="true">
            <svg viewBox="0 0 60 60" width="60" height="59" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path
                fill="currentColor"
                d="M30 0C30 16.5685 16.5685 30 0 30C16.5685 30 30 43.4315 30 60C30 43.4315 43.4315 30 60 30C43.4315 30 30 16.5685 30 0Z"
              />
            </svg>
          </span>
          <span class="banner-kit__sparkle banner-kit__sparkle--right" aria-hidden="true">
            <svg viewBox="0 0 60 60" width="60" height="59" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path
                fill="currentColor"
                d="M30 0C30 16.5685 16.5685 30 0 30C16.5685 30 30 43.4315 30 60C30 43.4315 43.4315 30 60 30C43.4315 30 30 16.5685 30 0Z"
              />
            </svg>
          </span>
        {%- endif -%}

        <div class="banner-kit__frame">
          <div
            id="x-banner-kit-{{ section.id }}"
            class="banner-kit__slider{% if enable_slider %} splide-slideshow overflow-hidden visible x-splide splide disable-effect-hover{% endif %}"
            {% if enable_slider %}
              x-intersect.once.margin.200px='$store.xSplide.load($el, {
                "speed": 800,
                "type": "loop",
                "arrows": false,
                "pagination": false,
                "autoplay": false,
                "autoHeight": false,
                "breakpoints": {
                  "767": {
                    "autoHeight": true
                  }
                },
                {%- if settings.lang_direction contains request.locale.iso_code -%}
                  "direction": "rtl",
                {%- endif -%}
              });
              const root = $el.closest(".banner-kit-{{ section.id }}");
              const fill = root ? root.querySelector("[data-banner2-fill]") : null;
              const imageMs = {{ autoplay_ms }};
              const autoPlay = {{ section.settings.auto_play | json }};
              const bindBanner2 = () => {
                const splide = $el.splide;
                if (!splide) {
                  requestAnimationFrame(bindBanner2);
                  return;
                }
                if ($el.dataset.banner2Bound === "1") return;
                $el.dataset.banner2Bound = "1";
                const setWidth = (pct) => {
                  if (fill) fill.style.width = Math.max(0, Math.min(100, pct)) + "%";
                };
                let activeVideo = null;
                let onEnded = null;
                let onTimeUpdate = null;
                let imageRaf = null;
                let imageStartedAt = 0;
                let imageRemaining = imageMs;
                let paused = false;

                const isVisible = (node) => {
                  let el = node;
                  while (el && el !== $el) {
                    const cs = window.getComputedStyle(el);
                    if (cs.display === "none" || cs.visibility === "hidden") return false;
                    el = el.parentElement;
                  }
                  return true;
                };

                const getActiveVideo = (slide) => {
                  const videos = slide.querySelectorAll("video.banner-kit__video");
                  for (let i = 0; i < videos.length; i++) {
                    if (isVisible(videos[i])) return videos[i];
                  }
                  return null;
                };

                const clearSlide = () => {
                  if (imageRaf) {
                    cancelAnimationFrame(imageRaf);
                    imageRaf = null;
                  }
                  if (activeVideo) {
                    if (onEnded) activeVideo.removeEventListener("ended", onEnded);
                    if (onTimeUpdate) activeVideo.removeEventListener("timeupdate", onTimeUpdate);
                    try { activeVideo.pause(); } catch (e) {}
                  }
                  activeVideo = null;
                  onEnded = null;
                  onTimeUpdate = null;
                };

                const pauseAllVideos = () => {
                  $el.querySelectorAll("video.banner-kit__video").forEach((v) => {
                    try { v.pause(); } catch (e) {}
                  });
                };

                const startImageTimer = () => {
                  imageStartedAt = performance.now();
                  const tick = () => {
                    if (paused) return;
                    const elapsed = performance.now() - imageStartedAt;
                    setWidth(Math.min(100, (elapsed / imageRemaining) * 100));
                    if (elapsed >= imageRemaining) {
                      setWidth(100);
                      imageRaf = null;
                      splide.go(">");
                      return;
                    }
                    imageRaf = requestAnimationFrame(tick);
                  };
                  imageRaf = requestAnimationFrame(tick);
                };

                const runSlide = () => {
                  clearSlide();
                  pauseAllVideos();
                  setWidth(0);
                  imageRemaining = imageMs;
                  if (!autoPlay) return;

                  const slideEntry = splide.Components.Slides.getAt(splide.index);
                  const slide = slideEntry && slideEntry.slide;
                  if (!slide) return;

                  const video = getActiveVideo(slide);
                  if (video) {
                    activeVideo = video;
                    video.loop = false;
                    video.muted = true;
                    try { video.currentTime = 0; } catch (e) {}
                    onTimeUpdate = () => {
                      if (video.duration && isFinite(video.duration)) {
                        setWidth((video.currentTime / video.duration) * 100);
                      }
                    };
                    onEnded = () => {
                      setWidth(100);
                      splide.go(">");
                    };
                    video.addEventListener("timeupdate", onTimeUpdate);
                    video.addEventListener("ended", onEnded);
                    const playPromise = video.play();
                    if (playPromise && playPromise.catch) {
                      playPromise.catch(() => startImageTimer());
                    }
                    return;
                  }

                  startImageTimer();
                };

                splide.on("mounted", runSlide);
                splide.on("moved", runSlide);

                $el.addEventListener("mouseenter", () => {
                  if (window.innerWidth < 768) return;
                  paused = true;
                  if (activeVideo && !activeVideo.paused) {
                    try { activeVideo.pause(); } catch (e) {}
                  }
                  if (imageRaf) {
                    cancelAnimationFrame(imageRaf);
                    imageRaf = null;
                    const elapsed = performance.now() - imageStartedAt;
                    imageRemaining = Math.max(200, imageRemaining - elapsed);
                  }
                });
                $el.addEventListener("mouseleave", () => {
                  if (window.innerWidth < 768) return;
                  paused = false;
                  if (activeVideo) {
                    const playPromise = activeVideo.play();
                    if (playPromise && playPromise.catch) playPromise.catch(() => {});
                    return;
                  }
                  if (autoPlay && imageRemaining > 0 && !imageRaf) {
                    startImageTimer();
                  }
                });

                if (splide.state >= 3) runSlide();
              };
              bindBanner2();
              '
            {% endif %}
          >
            <div class="{% if enable_slider %}splide__track{% endif %} overflow-hidden h-full">
              <div class="{% if enable_slider %}splide__list flex h-full{% else %}h-full{% endif %}">
                {%- if has_blocks -%}
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign slide_image = block.settings.image
                      assign slide_image_mobile = block.settings.image_mobile
                      assign slide_video = block.settings.video
                      assign slide_video_mobile = block.settings.video_mobile
                      assign has_video = false
                      if slide_video != blank or slide_video_mobile != blank
                        assign has_video = true
                      endif
                      assign has_media = false
                      if has_video or slide_image != blank or slide_image_mobile != blank
                        assign has_media = true
                      endif
                      assign slide_link = block.settings.link
                      assign button_label = block.settings.button_label
                      assign button_link = block.settings.button_link
                      if button_link == blank
                        assign button_link = slide_link
                      endif
                      if block.settings.image_alt != blank
                        assign slide_alt = block.settings.image_alt
                      else
                        assign slide_alt = 'sections.banner-kit.slide_alt' | t
                      endif
                      if forloop.first
                        assign slide_loading = 'eager'
                      else
                        assign slide_loading = 'lazy'
                      endif
                    -%}
                    <div
                      class="banner-kit__slide{% if enable_slider %} splide__slide x-splide-slide flex-shrink-0 w-full{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if has_media -%}
                        {%- capture slide_media -%}
                          <div class="banner-kit__media">
                            {%- if has_video -%}
                              {%- liquid
                                assign video_loop = true
                                if enable_slider
                                  assign video_loop = false
                                endif
                              -%}
                              <div class="banner-kit__video-wrap" data-banner2-has-video>
                                {%- liquid
                                  # Mobile: si el video móvil es de baja resolución (<750px),
                                  # usar el de escritorio (más nítido en pantallas retina).
                                  assign video_for_mobile = slide_video_mobile
                                  if video_for_mobile == blank
                                    assign video_for_mobile = slide_video
                                  endif
                                  if slide_video_mobile != blank and slide_video != blank and slide_video_mobile.preview_image != blank
                                    if slide_video_mobile.preview_image.width < 750
                                      assign video_for_mobile = slide_video
                                    endif
                                  endif
                                -%}
                                {%- if slide_video != blank and slide_video_mobile != blank -%}
                                  <div class="banner-kit__video-slot banner-kit__video-slot--mobile tw-w-full md:tw-hidden">
                                    {{
                                      video_for_mobile
                                      | video_tag:
                                        image_size: '1920x',
                                        autoplay: true,
                                        loop: video_loop,
                                        muted: true,
                                        controls: false,
                                        playsinline: true,
                                        preload: 'auto',
                                        class: 'banner-kit__video'
                                    }}
                                  </div>
                                  <div class="banner-kit__video-slot banner-kit__video-slot--desktop tw-hidden tw-w-full tw-h-full md:tw-block md:tw-absolute md:tw-inset-0">
                                    {{
                                      slide_video
                                      | video_tag:
                                        image_size: '1920x',
                                        autoplay: true,
                                        loop: video_loop,
                                        muted: true,
                                        controls: false,
                                        playsinline: true,
                                        class: 'banner-kit__video'
                                    }}
                                  </div>
                                {%- elsif slide_video != blank -%}
                                  {{
                                    slide_video
                                    | video_tag:
                                      image_size: '1920x',
                                      autoplay: true,
                                      loop: video_loop,
                                      muted: true,
                                      controls: false,
                                      playsinline: true,
                                      class: 'banner-kit__video'
                                  }}
                                {%- else -%}
                                  {{
                                    video_for_mobile
                                    | video_tag:
                                      image_size: '1920x',
                                      autoplay: true,
                                      loop: video_loop,
                                      muted: true,
                                      playsinline: true,
                                      controls: false,
                                      preload: 'auto',
                                      class: 'banner-kit__video'
                                  }}
                                {%- endif -%}
                              </div>
                            {%- else -%}
                              <picture class="banner-kit__picture">
                                {%- if slide_image_mobile != blank -%}
                                  <source
                                    media="(max-width: 767px)"
                                    srcset="
                                      {{ slide_image_mobile | image_url: width: 750 }} 750w,
                                      {{ slide_image_mobile | image_url: width: 1100 }} 1100w
                                    "
                                    sizes="100vw"
                                  >
                                {%- endif -%}
                                {%- if slide_image != blank -%}
                                  {{
                                    slide_image
                                    | image_url: width: 2400
                                    | image_tag:
                                      class: 'banner-kit__img',
                                      widths: '750, 1100, 1600, 2000, 2400',
                                      sizes: '100vw',
                                      alt: slide_alt,
                                      loading: slide_loading
                                  }}
                                {%- elsif slide_image_mobile != blank -%}
                                  {{
                                    slide_image_mobile
                                    | image_url: width: 1100
                                    | image_tag:
                                      class: 'banner-kit__img',
                                      widths: '750, 1100',
                                      sizes: '100vw',
                                      alt: slide_alt,
                                      loading: slide_loading
                                  }}
                                {%- endif -%}
                              </picture>
                            {%- endif -%}
                          </div>
                        {%- endcapture -%}

                        {%- if button_label == blank and slide_link != blank -%}
                          <a
                            href="{{ slide_link }}"
                            class="banner-kit__media-link"
                            aria-label="{{ slide_alt | escape }}"
                            {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                          >
                            {{ slide_media }}
                          </a>
                        {%- else -%}
                          {{ slide_media }}
                        {%- endif -%}

                        {%- if button_label != blank -%}
                          <div class="banner-kit__content">
                            {%- if button_link != blank -%}
                              <a
                                href="{{ button_link }}"
                                class="banner-kit__cta disable-effect"
                                {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                              >
                                {{ button_label | escape }}
                              </a>
                            {%- else -%}
                              <span class="banner-kit__cta">{{ button_label | escape }}</span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- elsif request.design_mode -%}
                        <div class="banner-kit__placeholder">
                          {{ 'sections.banner-kit.placeholder' | t }}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- elsif request.design_mode -%}
                  <div class="banner-kit__slide">
                    <div class="banner-kit__placeholder">
                      {{ 'sections.banner-kit.placeholder' | t }}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>

      {%- if enable_slider and section.settings.show_progress -%}
        <div class="banner-kit__progress" aria-hidden="true">
          <div class="banner-kit__progress-track">
            <div class="banner-kit__progress-fill" data-banner2-fill></div>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Banner 2",
  "tag": "section",
  "class": "section-banner-kit",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Mostrar banner",
