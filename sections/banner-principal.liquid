{%- liquid
  assign enable_slider = false
  assign visible_blocks_count = 0

  assign mobile_ar_w = 750
  assign mobile_ar_h = 400
  assign desktop_ar_w = 1920
  assign desktop_ar_h = 580
-%}

{%- for block in section.blocks -%}
  {%- capture slide_visible_capture -%}
    {%- render 'banner-principal-slide-visible',
      schedule_enabled: block.settings.schedule_enabled,
      schedule_start: block.settings.schedule_start,
      schedule_end: block.settings.schedule_end
    -%}
  {%- endcapture -%}
  {%- assign slide_visible = slide_visible_capture | strip -%}

  {%- if slide_visible == 'true' -%}
    {%- assign visible_blocks_count = visible_blocks_count | plus: 1 -%}

    {%- liquid
      assign block_desktop = block.settings.image
      assign block_mobile = block.settings.image_mobile

      if block_desktop != blank
        assign cmp_desktop = block_desktop.height | times: desktop_ar_w
        assign cmp_desktop_ref = desktop_ar_h | times: block_desktop.width
        if cmp_desktop > cmp_desktop_ref
          assign desktop_ar_h = block_desktop.height
          assign desktop_ar_w = block_desktop.width
        endif
      endif

      if block_mobile != blank
        assign cmp_mobile = block_mobile.height | times: mobile_ar_w
        assign cmp_mobile_ref = mobile_ar_h | times: block_mobile.width
        if cmp_mobile > cmp_mobile_ref
          assign mobile_ar_h = block_mobile.height
          assign mobile_ar_w = block_mobile.width
        endif
      elsif block_desktop != blank
        assign cmp_mobile = block_desktop.height | times: mobile_ar_w
        assign cmp_mobile_ref = mobile_ar_h | times: block_desktop.width
        if cmp_mobile > cmp_mobile_ref
          assign mobile_ar_h = block_desktop.height
          assign mobile_ar_w = block_desktop.width
        endif
      endif
    -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  if visible_blocks_count > 1
    assign enable_slider = true
  endif

  assign desktop_height = section.settings.banner_height
  assign mobile_height = section.settings.banner_height_mobile
  assign visible_slide_index = 0
-%}

{%- style -%}
  .banner-principal-{{ section.id }} {
    --banner-principal-max-h: {{ desktop_height }}px;
    --banner-principal-max-h-mobile: {{ mobile_height }}px;
    --banner-principal-slide-h: calc(100vw * {{ mobile_ar_h }} / {{ mobile_ar_w }});
    position: relative;
    width: 100%;
    line-height: 0;
  }
  @media (min-width: 768px) {
    /* Altura por aspect-ratio del slide (sin clamp 30vw que acortaba al achicar) */
    .banner-principal-{{ section.id }} {
      --banner-principal-slide-h: min(
        calc(100vw * {{ desktop_ar_h }} / {{ desktop_ar_w }}),
        var(--banner-principal-max-h)
      );
    }
  }
  .banner-principal-{{ section.id }} .banner-principal__slider {
    height: var(--banner-principal-slide-h);
  }
  .banner-principal-{{ section.id }} .banner-principal__slide,
  .banner-principal-{{ section.id }} .banner-principal__placeholder {
    position: relative;
    width: 100%;
    height: var(--banner-principal-slide-h);
    overflow: hidden;
  }
  .banner-principal-{{ section.id }} .splide__track,
  .banner-principal-{{ section.id }} .splide__list {
    height: 100%;
  }
  .banner-principal-{{ section.id }} .banner-principal__link,
  .banner-principal-{{ section.id }} .banner-principal__picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .banner-principal-{{ section.id }} .banner-principal__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  @media (max-width: 767px) {
    .banner-principal-{{ section.id }} .banner-principal__slide {
      height: auto;
    }
    .banner-principal-{{ section.id }} .banner-principal__slider,
    .banner-principal-{{ section.id }} .splide__track,
    .banner-principal-{{ section.id }} .splide__list {
      height: auto;
    }
    .banner-principal-{{ section.id }} .banner-principal__link,
    .banner-principal-{{ section.id }} .banner-principal__picture {
      height: auto;
    }
    .banner-principal-{{ section.id }} .banner-principal__img {
      width: 100%;
      height: auto;
      max-height: none;
      object-fit: contain;
      object-position: center top;
    }
  }
  .banner-principal-{{ section.id }} .banner-principal__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f2;
    color: #222222;
    text-align: center;
    padding: 1.5rem;
  }
  .banner-principal-{{ section.id }} .banner-principal__placeholder-text {
    font-size: 0.875rem;
    line-height: 1.4;
    max-width: 20rem;
  }
  .banner-principal-{{ section.id }} .splide__arrows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow {
    pointer-events: auto;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 28px;
    min-height: 44px;
    padding: 10px 2px;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: #222222;
    box-shadow: none;
    cursor: pointer;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }
  .banner-principal-{{ section.id }} .x-splide:hover .banner-principal__arrow {
    transform: translateY(-50%);
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow:hover,
  .banner-principal-{{ section.id }} .banner-principal__arrow:focus,
  .banner-principal-{{ section.id }} .banner-principal__arrow:focus-visible {
    background: rgba(255, 255, 255, 1);
    color: #222222;
    box-shadow: none;
    opacity: 1;
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow--prev {
    left: 0;
    border-radius: 0 6px 6px 0;
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow--next {
    right: 0;
    border-radius: 6px 0 0 6px;
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .banner-principal-{{ section.id }} .banner-principal__arrow-icon svg {
    width: 24px;
    height: 24px;
  }
{%- endstyle -%}

<div
  class="banner-principal-{{ section.id }} tw-w-full"
  role="region"
  aria-label="{{ 'sections.banner-principal.aria_label' | t }}"
>
  {%- if visible_blocks_count == 0 -%}
    {%- if request.design_mode -%}
      <div class="banner-principal__placeholder tw-p-8 tw-text-center tw-text-sm tw-text-[#737373]">
        {{ 'sections.banner-principal.no_active_slides' | t }}
      </div>
    {%- endif -%}
  {%- else -%}
  <div
    id="x-banner-principal-{{ section.id }}"
    class="banner-principal__slider splide-slideshow overflow-hidden visible tw-w-full{% if enable_slider %} x-splide splide disable-effect-hover{% endif %}"
    {% if enable_slider %}
      x-init='$store.xSplide.load($el, {
        "eager": true,
        "speed": 800,
        "type": "loop",
        "pauseOnHover": true,
        "pauseOnFocus": false,
        {%- if section.settings.auto_play -%}
          "autoplay": true,
          "interval": {{ section.settings.change_slides_speed | times: 1000 }},
        {%- endif -%}
        {%- if settings.lang_direction contains request.locale.iso_code -%}
          "direction": "rtl",
        {%- endif -%}
        "classes": {
          "arrows": "splide__arrows",
          "pagination": "hidden"
        }
      })'
    {% endif %}
  >
    <div class="{% if enable_slider %}splide__track{% endif %} overflow-hidden h-full">
      <div class="{% if enable_slider %}splide__list flex h-full{% else %}h-full{% endif %}">
        {%- for block in section.blocks -%}
          {%- capture slide_visible_capture -%}
            {%- render 'banner-principal-slide-visible',
              schedule_enabled: block.settings.schedule_enabled,
              schedule_start: block.settings.schedule_start,
              schedule_end: block.settings.schedule_end
            -%}
          {%- endcapture -%}
          {%- assign slide_visible = slide_visible_capture | strip -%}
          {%- unless slide_visible == 'true' -%}
            {%- continue -%}
          {%- endunless -%}
          {%- liquid
            assign visible_slide_index = visible_slide_index | plus: 1
            assign slide_image = block.settings.image
            assign slide_image_mobile = block.settings.image_mobile
            assign slide_link = block.settings.link
            if block.settings.image_alt != blank
              assign slide_alt = block.settings.image_alt
            else
              assign slide_alt = 'sections.banner-principal.slide_alt' | t
            endif
            if visible_slide_index == 1
              assign slide_loading = 'eager'
              assign slide_fetchpriority = 'high'
            else
              assign slide_loading = 'lazy'
              assign slide_fetchpriority = 'low'
            endif
          -%}
          <div
            class="banner-principal__slide{% if enable_slider %} splide__slide x-splide-slide flex-shrink-0 w-full{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if slide_image != blank or slide_image_mobile != blank -%}
              {%- if slide_link != blank -%}
                <a
                  href="{{ slide_link }}"
                  class="banner-principal__link"
                  {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
              {%- endif -%}
              <picture class="banner-principal__picture">
                {%- if slide_image_mobile != blank -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="
                      {{ slide_image_mobile | image_url: width: 550 }} 550w,
                      {{ slide_image_mobile | image_url: width: 750 }} 750w,
                      {{ slide_image_mobile | image_url: width: 990 }} 990w,
                      {{ slide_image_mobile | image_url: width: 1200 }} 1200w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {%- if slide_image != blank -%}
                  {{
                    slide_image
                    | image_url: width: 3840
                    | image_tag:
                      class: 'banner-principal__img',
                      widths: '750, 990, 1200, 1500, 1920, 2560, 3840',
                      sizes: '100vw',
                      alt: slide_alt,
                      loading: slide_loading,
                      fetchpriority: slide_fetchpriority
                  }}
                {%- elsif slide_image_mobile != blank -%}
                  {{
                    slide_image_mobile
                    | image_url: width: 1200
                    | image_tag:
                      class: 'banner-principal__img',
                      widths: '550, 750, 990, 1200',
                      sizes: '100vw',
                      alt: slide_alt,
                      loading: slide_loading,
                      fetchpriority: slide_fetchpriority
                  }}
                {%- endif -%}
              </picture>
              {%- if slide_link != blank -%}
                </a>
              {%- endif -%}
            {%- else -%}
              <div class="banner-principal__placeholder">
                {%- if request.design_mode -%}
                  <p class="banner-principal__placeholder-text">
                    {{ 'sections.banner-principal.placeholder' | t }}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if enable_slider and section.settings.show_arrows -%}
      <div class="splide__arrows{% if settings.lang_direction contains request.locale.iso_code %} rtl{% endif %}">
        <button
          type="button"
          class="banner-principal__arrow banner-principal__arrow--prev splide__arrow splide__arrow--prev none_border"
          aria-label="{{ 'sections.banner-principal.previous' | t }}"
        >
          <span class="banner-principal__arrow-icon rotate-90 rtl:-rotate-90" aria-hidden="true">
            {% render 'icon-alls', icon: 'icon-caret' %}
          </span>
        </button>
        <button
          type="button"
          class="banner-principal__arrow banner-principal__arrow--next splide__arrow splide__arrow--next none_border"
          aria-label="{{ 'sections.banner-principal.next' | t }}"
        >
          <span class="banner-principal__arrow-icon -rotate-90 rtl:rotate-90" aria-hidden="true">
            {% render 'icon-alls', icon: 'icon-caret' %}
          </span>
        </button>
      </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Banner principal",
  "tag": "section",
  "class": "section-banner-principal",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Reproducción automática",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "label": "Segundos por diapositiva",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas de navegación",
      "default": true
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Altura máxima en escritorio (px)",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 580
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Altura máxima en móvil (px)",
      "info": "Solo aplica como referencia. En móvil el banner usa la proporción completa de la imagen para evitar recortes.",
      "min": 240,
      "max": 600,
      "step": 10,
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (escritorio)",
          "info": "Recomendado 1920×580 px. La altura se adapta al ancho de pantalla según la proporción de la imagen."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen (móvil)",
          "info": "Recomendado 750×400 px o similar. Si está vacía, se usa la imagen de escritorio."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texto alternativo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del banner"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Abrir enlace en nueva pestaña",
          "default": false
        },
        {
          "type": "header",
          "content": "Programación por fecha"
        },
        {
          "type": "checkbox",
          "id": "schedule_enabled",
          "label": "Activar programación",
          "default": false,
          "info": "Si está activo, la diapositiva solo se muestra según las fechas indicadas (hora de la tienda). Sin inicio: visible hasta el fin. Sin fin: visible desde el inicio en adelante. En el editor del tema siempre se previsualiza."
        },
        {
          "type": "text",
          "id": "schedule_start",
          "label": "Inicio",
          "info": "Opcional. Ej: 2026-08-01 00:00:00 o 2026-08-01. Si se deja vacío, la diapositiva estará activa hasta la fecha de fin."
        },
        {
          "type": "text",
          "id": "schedule_end",
          "label": "Fin",
          "info": "Opcional. Ej: 2026-08-31 23:59:59 o 2026-08-31. Si se deja vacío, la diapositiva no se oculta después del inicio."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner principal",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
