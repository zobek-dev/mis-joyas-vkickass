{%- if section.settings.enable -%}
{%- style -%}
  .mj-topbar-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mj-topbar__inner-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    gap: {{ section.settings.gap_desktop }}px;
    min-height: 36px;
    padding: 2px 16px 5px;
    font-size: 14px;
    line-height: 20px;
  }
  .mj-topbar__item-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 1 auto;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .mj-topbar__item-{{ section.id }}--underline .mj-topbar__text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .mj-topbar__item-{{ section.id }}:hover .mj-topbar__text {
    opacity: 0.85;
  }
  .mj-topbar__icon-{{ section.id }} {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .mj-topbar__text {
    font-weight: 400;
  }
  .mj-topbar__text strong {
    font-weight: 600;
  }
  .mj-topbar__chevron-{{ section.id }} {
    display: block;
    width: 3.5px;
    height: 8.66px;
    flex-shrink: 0;
    color: {{ section.settings.accent_color }};
  }
  /* Mobile — Figma 1414:4314: side inset + gap, without overflowing the viewport */
  @media (max-width: 749px) {
    .mj-topbar__inner-{{ section.id }} {
      justify-content: center;
      gap: {{ section.settings.gap_mobile }}px;
      padding: 2px 20px 5px;
    }
    .mj-topbar__item-{{ section.id }}--hide-mobile {
      display: none;
    }
    .mj-topbar__item-{{ section.id }}--underline .mj-topbar__text {
      text-decoration: none;
    }
  }
{%- endstyle -%}

<div class="mj-topbar-{{ section.id }}">
  <div class="mj-topbar__inner-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_classes = 'mj-topbar__item-' | append: section.id
        if block.settings.underline
          assign item_classes = item_classes | append: ' mj-topbar__item-' | append: section.id | append: '--underline'
        endif
        if block.settings.hide_on_mobile
          assign item_classes = item_classes | append: ' mj-topbar__item-' | append: section.id | append: '--hide-mobile'
        endif
      -%}

      {%- if block.settings.link != blank -%}
        <a
          href="{{ block.settings.link }}"
          class="{{ item_classes }}"
          {% if block.settings.open_new_window %}target="_blank" rel="noopener"{% endif %}
          {{ block.shopify_attributes }}
        >
      {%- else -%}
        <span class="{{ item_classes }}" {{ block.shopify_attributes }}>
      {%- endif -%}

        {%- if block.settings.show_icon -%}
          <img
            class="mj-topbar__icon-{{ section.id }}"
            src="{{ 'misjoyas-topbar-check.png' | asset_url }}"
            alt=""
            width="20"
            height="20"
            loading="lazy"
          >
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <span class="mj-topbar__text">{{ block.settings.text }}</span>
        {%- endif -%}

        {%- if block.settings.show_chevron -%}
          <svg class="mj-topbar__chevron-{{ section.id }}" viewBox="0 0 3.5 8.66" aria-hidden="true" focusable="false">
            <path d="M0 0L3.5 4.33L0 8.66V0Z" fill="currentColor"/>
          </svg>
        {%- endif -%}

      {%- if block.settings.link != blank -%}
        </a>
      {%- else -%}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Topbar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Mostrar barra",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de flecha",
      "default": "#f83785"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Separación desktop (px)",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Separación mobile (px)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ítem",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "Texto del ítem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "checkbox",
          "id": "open_new_window",
          "label": "Abrir en nueva ventana",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Mostrar icono",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_chevron",
          "label": "Mostrar flecha",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "underline",
          "label": "Subrayar texto",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "hide_on_mobile",
          "label": "Ocultar en mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Topbar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "<strong>Plata 925</strong> certificada",
            "show_icon": true,
            "show_chevron": true,
            "underline": true,
            "hide_on_mobile": false
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Todo para <strong>emprender</strong>",
            "show_icon": false,
            "show_chevron": true,
            "underline": true,
            "hide_on_mobile": true
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "<strong>Tiendas — </strong>37 en todo Chile",
            "show_icon": false,
            "show_chevron": true,
            "underline": true,
            "hide_on_mobile": false
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "<strong>Despacho gratis</strong> sobre $99.990",
            "show_icon": false,
            "show_chevron": false,
            "underline": false,
            "hide_on_mobile": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
