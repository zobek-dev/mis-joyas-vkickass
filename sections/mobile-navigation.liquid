{% comment %}
  Chrome settings for the mobile drawer only (logo + footer).
  Menu items render from header.liquid → snippets/mj-mobile-nav-drawer.liquid
  using the same Button / Tree menu blocks as desktop.
  Keep this section enabled so theme editor settings are available via sections['mobile-navigation'].
{% endcomment %}
{%- comment -%} Minimal output so the section stays in the group and settings resolve. {%- endcomment -%}
<div class="tw-hidden" aria-hidden="true" data-mj-mobile-nav-settings></div>
{% schema %}
{
  "name": "t:sections.mobile-navigation.name",
  "class": "section-mobile-navigation",
  "settings": [
    {
      "type": "paragraph",
      "content": "El menú mobile usa los bloques Button / Tree menu del Header. Aquí solo configuras logo y pie del drawer."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Si está vacío, usa el logo del Header."
    },
    {
      "type": "header",
      "content": "Pie del menú"
    },
    {
      "type": "checkbox",
      "id": "show_stores_footer",
      "default": true,
      "label": "Mostrar fila de tiendas"
    },
        {
          "type": "text",
      "id": "stores_footer_text",
      "label": "Texto de tiendas",
      "default": "Tiendas — 37 en todo Chile"
        },
        {
          "type": "url",
          "id": "stores_footer_link",
          "label": "Enlace de tiendas"
        },
        {
          "type": "checkbox",
          "id": "show_footer_links",
          "default": true,
          "label": "Mostrar enlaces de utilidad"
        },
        {
          "type": "text",
          "id": "footer_link_1_text",
          "label": "Enlace 1 — texto",
          "default": "**Plata 925** certificada",
          "info": "Usa **texto** para negrita."
    },
    {
      "type": "url",
      "id": "footer_link_1_link",
      "label": "Enlace 1 — URL"
        },
        {
          "type": "checkbox",
          "id": "footer_link_1_show_check",
          "default": true,
          "label": "Mostrar check en enlace 1"
        },
        {
          "type": "text",
          "id": "footer_link_2_text",
          "label": "Enlace 2 — texto",
          "default": "Todo para **emprender**",
          "info": "Usa **texto** para negrita."
        },
        {
          "type": "url",
          "id": "footer_link_2_link",
          "label": "Enlace 2 — URL"
        },
        {
          "type": "checkbox",
      "id": "show_footer_login",
      "default": true,
      "label": "Mostrar login"
    },
    {
      "type": "checkbox",
      "id": "show_footer_social",
      "default": true,
      "label": "Mostrar redes sociales"
        },
        {
          "type": "header",
      "content": "Idioma / moneda"
        },
        {
          "type": "checkbox",
      "id": "show_language_selector",
          "default": false,
      "label": "t:sections.header.settings.show_language_selector.label"
        },
        {
          "type": "checkbox",
      "id": "show_currency_selector",
          "default": false,
      "label": "t:sections.header.settings.show_currency_selector.label"
        },
        {
          "type": "header",
      "content": "Colores"
        },
        {
          "type": "color",
      "id": "background_color",
      "default": "#FFFFFF",
      "label": "t:sections.all.background.background_color_light"
        },
        {
          "type": "color",
      "id": "text_color",
      "default": "#000000",
      "label": "t:sections.all.text.color"
    }
  ],
  "presets": [
    {
      "name": "t:sections.mobile-navigation.name"
    }
  ]
}
{% endschema %}
