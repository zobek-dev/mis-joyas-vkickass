{%- comment -%}
  Reseñas destacadas — Mediahuella para MisJoyas
  Muro de reseñas verificadas de Loox filtrado a 4 y 5 estrellas.
  Loox no permite filtrar su widget por rango de estrellas, por eso las
  reseñas se sincronizan y quedan escritas en esta sección.
  Actualizar con: resenas-loox/extraer-loox.py -> curar.py -> generar-seccion.py
  Última sincronización: 2026-08-31
{%- endcomment -%}

{%- liquid
  assign bg = section.settings.background_color | default: '#ffffff'
  assign card_bg = section.settings.card_background | default: '#f8f4f0'
  assign txt = section.settings.text_color | default: '#2d2d2d'
  assign star = section.settings.star_color | default: '#f83785'
  assign pad_y = section.settings.padding_y | default: 56
  assign pad_y_mobile = section.settings.padding_y_mobile | default: 40
-%}

{%- style -%}
  .resenas-destacadas-{{ section.id }} {
    background: {{ bg }};
    color: {{ txt }};
    padding: {{ pad_y_mobile }}px 0;
  }
  @media (min-width: 768px) {
    .resenas-destacadas-{{ section.id }} { padding: {{ pad_y }}px 0; }
  }
  .resenas-destacadas-{{ section.id }} .rd-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .resenas-destacadas-{{ section.id }} .rd-inner { padding: 0 40px; }
  }
  .resenas-destacadas-{{ section.id }} .rd-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .resenas-destacadas-{{ section.id }} .rd-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
  }
  @media (min-width: 768px) {
    .resenas-destacadas-{{ section.id }} .rd-title { font-size: 30px; }
  }
  .resenas-destacadas-{{ section.id }} .rd-sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.4;
    opacity: .8;
  }
  .resenas-destacadas-{{ section.id }} .rd-summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
  }
  .resenas-destacadas-{{ section.id }} .rd-summary .rd-star { width: 18px; height: 18px; }
  .resenas-destacadas-{{ section.id }} .rd-star {
    width: 15px;
    height: 15px;
    display: inline-block;
    flex: none;
  }
  .resenas-destacadas-{{ section.id }} .rd-star.is-full { fill: {{ star }}; }
  .resenas-destacadas-{{ section.id }} .rd-star.is-empty { fill: currentColor; opacity: .18; }
  .resenas-destacadas-{{ section.id }} .rd-viewport { position: relative; }
  .resenas-destacadas-{{ section.id }} .rd-track {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .resenas-destacadas-{{ section.id }} .rd-track::-webkit-scrollbar { display: none; }
  .resenas-destacadas-{{ section.id }} .rd-card {
    flex: 0 0 auto;
    width: 72%;
    max-width: 300px;
    scroll-snap-align: start;
    background: {{ card_bg }};
    overflow: hidden;
  }
  @media (min-width: 600px) {
    .resenas-destacadas-{{ section.id }} .rd-card { width: 42%; }
  }
  @media (min-width: 900px) {
    .resenas-destacadas-{{ section.id }} .rd-card { width: 30%; }
  }
  @media (min-width: 1100px) {
    .resenas-destacadas-{{ section.id }} .rd-card { width: calc((100% - 36px) / 4); max-width: none; }
  }
  .resenas-destacadas-{{ section.id }} .rd-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: rgba(0, 0, 0, .05);
    overflow: hidden;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__link:hover .rd-card__media img { transform: scale(1.04); }
  .resenas-destacadas-{{ section.id }} .rd-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
    flex: 1 1 auto;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__stars { display: inline-flex; gap: 2px; }
  .resenas-destacadas-{{ section.id }} .rd-card__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    min-height: 4.35em; /* 3 lineas: alinea el pie de todas las tarjetas */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 13px;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__author { font-weight: 600; }
  .resenas-destacadas-{{ section.id }} .rd-card__verified {
    font-size: 12px;
    opacity: .7;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__verified::before {
    content: '✓';
    margin-right: 3px;
    color: {{ star }};
    font-weight: 700;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__product {
    margin: 0;
    font-size: 13px;
    opacity: .75;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .resenas-destacadas-{{ section.id }} .rd-card__date {
    font-size: 11px;
    opacity: .55;
    margin-top: auto;
    padding-top: 4px;
  }
  .resenas-destacadas-{{ section.id }} .rd-nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, .12);
    background: #fff;
    color: #2d2d2d;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
    z-index: 2;
  }
  .resenas-destacadas-{{ section.id }} .rd-nav[hidden] { display: none !important; }
  .resenas-destacadas-{{ section.id }} .rd-nav--prev { left: -14px; }
  .resenas-destacadas-{{ section.id }} .rd-nav--next { right: -14px; }
  @media (min-width: 1100px) {
    .resenas-destacadas-{{ section.id }} .rd-nav { display: flex; }
  }
  .resenas-destacadas-{{ section.id }} .rd-cta {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .resenas-destacadas-{{ section.id }} .rd-cta a {
    display: inline-block;
    padding: 12px 28px;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .resenas-destacadas-{{ section.id }} .rd-cta a:hover {
    background: {{ star }};
    border-color: {{ star }};
    color: #fff;
  }
{%- endstyle -%}

<div class="resenas-destacadas-{{ section.id }}">
