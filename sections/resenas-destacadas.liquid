<script>
  (function () {
    var raiz = document.querySelector('.resenas-destacadas-{{ section.id }}');
    if (!raiz) return;
    var pista = raiz.querySelector('[data-rd-track]');
    var prev = raiz.querySelector('[data-rd-prev]');
    var next = raiz.querySelector('[data-rd-next]');
    if (!pista || !prev || !next) return;

    function paso() {
      var t = pista.querySelector('.rd-card');
      return t ? t.getBoundingClientRect().width + 12 : pista.clientWidth * 0.8;
    }
    function estado() {
      var max = pista.scrollWidth - pista.clientWidth - 2;
      prev.hidden = pista.scrollLeft <= 2;
      next.hidden = pista.scrollLeft >= max;
    }
    prev.addEventListener('click', function () { pista.scrollBy({ left: -paso(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { pista.scrollBy({ left: paso(), behavior: 'smooth' }); });
    pista.addEventListener('scroll', estado, { passive: true });
    window.addEventListener('resize', estado);
    estado();
  })();
</script>

