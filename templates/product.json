    "custom_liquid_NLGn9E": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "{%- capture metal_str -%}{%- render 'misjoyas-metal-str', product: product -%}{%- endcapture -%}\n{%- assign metal_str = metal_str | strip -%}\n{%- liquid\n  assign is_plata = false\n  assign is_revestimiento = false\n  if metal_str == 'Plata 925'\n    assign is_plata = true\n  elsif metal_str == 'Recubrimiento Baño de Oro 18k'\n    assign is_revestimiento = true\n  endif\n-%}\n{%- if is_revestimiento -%}\n<div class=\"misjoyas-details\">\n\n  {%- comment -%}\n  Detalles adicionales (temporalmente desactivado — descripción completa va bajo el precio).\n  {%- liquid\n    assign clean_description = product.description | replace: '</p>', '</p><!--MJBR-->' | replace: '<br>', '<!--MJBR-->' | replace: '<br/>', '<!--MJBR-->' | replace: '<br />', '<!--MJBR-->' | strip_html | replace: '<!--MJBR-->', '<br>' | replace: 'Grosor:', '<br>Grosor:' | replace: 'Ancho:', '<br>Ancho:' | strip\n  -%}\n  {%- if clean_description != blank -%}\n  <div class=\"misjoyas-details__item\" data-open=\"true\">\n    <button type=\"button\" class=\"misjoyas-details__header\" aria-expanded=\"true\">\n      <span class=\"misjoyas-details__title\">Detalles adicionales</span>\n      <span class=\"misjoyas-details__toggle\" aria-hidden=\"true\">−</span>\n    </button>\n    <div class=\"misjoyas-details__panel\">\n      <div class=\"misjoyas-details__body\">{{ clean_description }}</div>\n    </div>\n  </div>\n  {%- endif -%}\n  {%- endcomment -%}\n\n  <div class=\"misjoyas-details__item\" data-open=\"true\">\n    <button type=\"button\" class=\"misjoyas-details__header\" aria-expanded=\"true\">\n      <span class=\"misjoyas-details__title\">Protección y terminación</span>\n      <span class=\"misjoyas-details__toggle\" aria-hidden=\"true\">−</span>\n    </button>\n    <div class=\"misjoyas-details__panel\">\n      <div class=\"misjoyas-details__body\">\n        Barniz protector italiano que ayuda a conservar el brillo y la apariencia de la pieza en el tiempo.<br>\n        Terminación de pulido premium bajo el estándar de calidad MISJOYAS.\n      </div>\n    </div>\n  </div>\n\n  <div class=\"misjoyas-details__item\" data-open=\"true\">\n    <button type=\"button\" class=\"misjoyas-details__header\" aria-expanded=\"true\">\n      <span class=\"misjoyas-details__title\">Cuidados</span>\n      <span class=\"misjoyas-details__toggle\" aria-hidden=\"true\">−</span>\n    </button>\n    <div class=\"misjoyas-details__panel\">\n      <div class=\"misjoyas-details__body\">\n        Evitar agua, perfumes, cremas, productos químicos y humedad. Guardar por separado (en su estuche) y limpiar con un paño seco.<br>\n        Ponte la joya al final, después de cremas y perfume.\n      </div>\n    </div>\n  </div>\n\n</div>\n{%- endif -%}\n\n{%- if is_plata or is_revestimiento -%}\n<div class=\"misjoyas-estandar\">\n  <picture>\n    {%- if is_revestimiento -%}\n      <source media=\"(max-width: 767px)\" srcset=\"{{ 'estandar-Oro-MJ_mobile.jpg' | asset_url }}\" width=\"800\" height=\"1664\">\n      <img\n        class=\"misjoyas-estandar__img\"\n        src=\"{{ 'estandar-Oro-MJ_desktop.jpg' | asset_url }}\"\n        alt=\"Estándar MISJOYAS — Calidad certificada Baño de Oro 18K\"\n        width=\"2560\"\n        height=\"560\"\n        loading=\"lazy\"\n        decoding=\"async\"\n      >\n    {%- else -%}\n      <source media=\"(max-width: 767px)\" srcset=\"{{ 'estandar-Plata-MJ_mobile.jpg' | asset_url }}\" width=\"800\" height=\"1664\">\n      <img\n        class=\"misjoyas-estandar__img\"\n        src=\"{{ 'estandar-Plata-MJ_desktop.jpg' | asset_url }}\"\n        alt=\"Estándar MISJOYAS — Calidad certificada Plata 925\"\n        width=\"2560\"\n        height=\"560\"\n        loading=\"lazy\"\n        decoding=\"async\"\n      >\n    {%- endif -%}\n  </picture>\n</div>\n{%- endif -%}",
