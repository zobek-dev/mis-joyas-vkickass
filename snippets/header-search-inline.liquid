{%- liquid
  assign search_type = 'query,' | append: settings.search_type
-%}
<div
  class="mj-header-search hidden lg:flex tw-items-center tw-relative tw-w-[500px] tw-max-w-[min(500px,42vw)]"
  x-data="xInlineSearch('{{ search_type }}', {{ settings.search_desktop_maximun_results | default: 6 }})"
  @click.away="closeResults()"
  @keyup.escape="closeResults()"
>
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="tw-flex tw-items-center tw-h-[50px] tw-w-full tw-bg-white tw-border-[0.5px] tw-border-black tw-rounded-[4px] tw-pl-3 tw-pr-[5px] tw-gap-3"
  >
    <input type="hidden" name="options[prefix]" value="last">
    <input
      type="search"
      name="q"
      x-model="query"
      @input="keyUp()"
      @focus="focusForm()"
      class="tw-flex-1 tw-min-w-0 tw-bg-transparent tw-outline-none tw-text-base tw-leading-[22px] tw-text-[#2d2d2d] placeholder:tw-text-[#2d2d2d] placeholder:tw-opacity-70 [appearance:none] [-webkit-appearance:none]"
      placeholder="{{ 'general.search.placeholder' | t }}"
      autocomplete="off"
      aria-label="{{ 'general.search.search' | t }}"
    >
    <button
      type="submit"
      class="mj-header-search__btn tw-shrink-0 tw-flex tw-items-center tw-justify-center tw-w-10 tw-h-10 tw-rounded-full tw-bg-[#f8f4f0] tw-text-black hover:tw-opacity-90 tw-transition-opacity"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <img
        src="{{ 'misjoyas-search-icon.svg' | asset_url }}"
        alt=""
        width="18"
        height="18"
        class="tw-w-[18px] tw-h-[18px] tw-block"
        loading="lazy"
      >
    </button>
  </form>

  {%- if settings.predictive_search_enabled -%}
    <div
      x-show="openResults"
      x-cloak
      x-html="result"
      class="tw-absolute tw-top-full tw-mt-1.5 tw-left-0 tw-w-full tw-z-50 tw-bg-white tw-shadow-md tw-rounded-[4px] tw-border tw-border-black/10 tw-max-h-96 tw-overflow-y-auto text-[rgb(var(--colors-text))]"
    ></div>
  {%- endif -%}
</div>
