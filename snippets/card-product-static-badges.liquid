{% comment %}
  Badges estáticos para tarjetas (sin xBadges JS).
  Replica las etiquetas principales: nuevo, promo, agotado.
  El % de descuento se muestra junto al precio (price.liquid).
{% endcomment %}
{%- liquid
  assign show_new = false
  assign current_ts = 'now' | date: '%s'
  assign published_ts = product.published_at | date: '%s'
  assign diff_days = current_ts | minus: published_ts | times: 1.0 | divided_by: 86400 | round

  for col in product.collections
    if col.handle == 'nuevo' and diff_days <= 25
      assign show_new = true
      break
    endif
  endfor

  assign show_dia_madre = false
  if product.tags contains 'dia-madre'
    assign show_dia_madre = true
  endif
-%}

{%- if show_new or show_dia_madre or product.available == false -%}
  <div class="top-left-container label-container absolute gap-1 top-1 left-1 pointer-events-none z-20">
    {%- if show_new -%}
      <div class="x-badge-new-label x-badge-container pointer-events-none ltr w-max text-start">
        <div class="x-badge-content ltr x-badge-text x-badge-text--new select-none inline-flex justify-center items-center">
          <span class="leading-normal w-fit p-break-words">Nuevo</span>
        </div>
      </div>
    {%- endif -%}

    {%- if show_dia_madre -%}
      <div class="x-badge-container pointer-events-none ltr w-max text-start">
        <div
          class="x-badge-content ltr x-badge-text select-none inline-flex justify-center items-center"
          style="font-size: 14px; background-color: #f83785; color: #ffffff;"
        >
          <span class="leading-normal w-fit p-break-words">Día de la Madre</span>
        </div>
      </div>
    {%- endif -%}

    {%- unless product.available -%}
      <div class="x-badge-container pointer-events-none ltr w-max text-start">
        <div
          class="x-badge-content ltr x-badge-text select-none inline-flex justify-center items-center"
          style="font-size: 14px; background-color: #444444; color: #ffffff;"
        >
          <span class="leading-normal w-fit p-break-words">{{ 'products.product.sold_out' | t }}</span>
        </div>
      </div>
    {%- endunless -%}
  </div>
{%- endif -%}
